{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Task|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/claude_code_pretooluse.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
